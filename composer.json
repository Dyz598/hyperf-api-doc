{
    "name": "dyz598/hyperf-api-doc",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "hyperf",
        "openapi",
        "api-doc",
        "documentation"
    ],
    "description": "Inference-first OpenAPI documentation generator for Hyperf.",
    "autoload": {
        "psr-4": {
            "HyperfApiDoc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HyperfTest\\": "tests"
        }
    },
    "require": {
        "php": ">=8.1",
        "hyperf/command": "~3.1.0",
        "hyperf/config": "~3.1.0",
        "hyperf/di": "~3.1.0",
        "hyperf/framework": "~3.1.0",
        "hyperf/http-server": "~3.1.0",
        "hyperf/validation": "~3.1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "hyperf/resource": "~3.1.0",
        "mockery/mockery": "^1.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": ">=7.0",
        "swoole/ide-helper": "^4.5",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "hyperf/devtool": "Required to publish the config file via vendor:publish.",
        "hyperf/resource": "Enables resource response wrapping and schema inference.",
        "menumbing/hyperf-auth": "Strategies for its #[Auth] attribute ship built-in.",
        "menumbing/resource": "Strategies for its #[WithResource] attribute and response envelope ship built-in.",
        "symfony/yaml": "Required to output YAML format (*.yaml).",
        "swow/swow": "Required to create swow components."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml --colors=always",
        "analyse": "phpstan analyse --memory-limit 1024M -l 0 ./src",
        "cs-fix": "php-cs-fixer fix $1"
    },
    "extra": {
        "hyperf": {
            "config": "HyperfApiDoc\\ConfigProvider"
        },
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    }
}
